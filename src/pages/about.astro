---
import { site } from '../data/site';
import TextPage from '../components/TextPage.astro';
---

<TextPage
  title="About"
  intro="Hi, I'm Apoorva. I build cloud software, and then I go get thrown around a gym."
  description="Who Apoorva Sharma is, what he builds and what he trains."
>
  <h2>Who I am</h2>
  <p>
    I'm a software engineer who trains like it's a second job. This site is where I keep what I learn on both sides, so
    future me stops googling the same things.
  </p>

  <h2>What I do</h2>
  <ul>
    <li>DevOps and cloud backends</li>
    <li>Making cloud bills smaller</li>
    <li>AI agents and agentic workflows</li>
    <li>Mobile apps</li>
  </ul>

  <h2>What I train</h2>
  <p>
    Squats, pull-ups, rings, handstands and wrestling, with a lot of falling over. I've been in the gym since 7 Jan 2019
    and I log every session in an app I built myself (traininglogs). I'm working toward the CSCS certification.
  </p>

  <h2>Where to find me</h2>
  <div class="cta">
    <a class="btn primary" href={site.resume}>Résumé</a>
    <a class="btn" href={site.github}>GitHub</a>
    <a class="btn" href={site.youtube}>YouTube</a>
    <a class="btn" href={site.instagram}>Instagram</a>
  </div>
</TextPage>
