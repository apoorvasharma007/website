---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = [
  { t: 'Building traininglogs: A Python Pipeline for My Gym Data', d: 'How and why I built a parser that turns my messy training notes into structured JSON.', m: '2 Apr 2026' },
  { t: 'Testing in Python: What to Test and What to Skip', d: 'Not everything needs a test. Understanding the difference is what makes a test suite useful rather than expensive.', m: '15 Mar 2026' },
  { t: 'What I Learned Deploying On Azure For The First Time', d: 'The three things that cost me a weekend, and the one that saved it.', m: '28 Feb 2026' },
];
---
<BaseLayout title="List designs">
  <main class="lab">
    <h1>Pick a list design</h1>
    <p class="note">Same three real posts in each. Chapters in a knowledge base would use the same design, without the date.</p>

    <h2>A. Separate cards</h2>
    <div class="a">{posts.map((p) => <a href="#"><strong>{p.t}</strong><span>{p.d}</span><em>{p.m}</em></a>)}</div>

    <h2>B. Open list, no boxes</h2>
    <div class="b">{posts.map((p) => <a href="#"><div><strong>{p.t}</strong><span>{p.d}</span></div><em>{p.m}</em></a>)}</div>

    <h2>C. Two columns of cards, date on top</h2>
    <div class="c">{posts.map((p) => <a href="#"><em>{p.m}</em><strong>{p.t}</strong><span>{p.d}</span></a>)}</div>
  </main>
</BaseLayout>

<style>
  .lab { max-width: 66rem; margin: 0 auto; padding: 2.5rem clamp(1rem, 4vw, 2rem) 6rem; }
  h1 { font-size: 2rem; letter-spacing: -0.03em; }
  h2 { margin-top: 3.5rem; font-size: 1rem; color: var(--muted); font-weight: 500; }
  .note { margin-top: 0.5rem; color: var(--muted); }
  strong { font-weight: 550; letter-spacing: -0.01em; }
  span { color: var(--body); font-size: 0.9375rem; line-height: 1.5; }
  em { font-style: normal; font-size: 0.8125rem; color: var(--dim); }

  .a { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .a a { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 1.125rem; border: 1px solid var(--line); border-radius: 0.875rem; background: var(--panel); transition: border-color .2s, transform .25s; }
  .a a:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .a em { margin-top: .25rem; }

  .b { margin-top: 1rem; }
  .b a { display: flex; justify-content: space-between; align-items: baseline; gap: 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .b a:last-child { border-bottom: 1px solid var(--line); }
  .b div { display: grid; gap: 0.375rem; max-width: 40rem; }
  .b strong { font-size: 1.25rem; letter-spacing: -0.02em; transition: transform .3s; }
  .b a:hover strong { transform: translateX(.5rem); }
  .b em { white-space: nowrap; }
  @media (max-width: 640px) { .b a { flex-direction: column; gap: .5rem; } }

  .c { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 800px) { .c { grid-template-columns: 1fr 1fr; } }
  .c a { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem 1.375rem 1.5rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--panel); min-height: 11rem; transition: border-color .2s, transform .25s; }
  .c a:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .c strong { font-size: 1.125rem; line-height: 1.3; }
</style>
