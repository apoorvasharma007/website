---
import BaseLayout from '../../layouts/BaseLayout.astro';
const scenes = [
  { side: 'tech', lead: 'I like', phrase: 'Building Tech', art: '/art/whack-a-bug.svg', caption: 'Cloud stuff, websites and the odd bug hunt.' },
  { side: 'fit', lead: 'I love', phrase: 'Working Out', art: '/art/clean-and-jerk-flipped.svg', caption: 'Rings, weights, handstands and juggling.' },
];
const variants = [
  ['A. Quiet', 'a', 'Lead words white, phrase in color, small caption in the body tone.'],
  ['B. Bold', 'b', 'Whole line in color, bigger, caption in full white.'],
  ['C. Lead above', 'c', 'Small "I like" above a big colored phrase, caption muted.'],
];
---
<BaseLayout title="Hero combos">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kalam:wght@700&display=swap" />
  <main class="lab">
    <p class="note">Same two scenes in three looks. Name stays in the original font. The fitness art is the mirrored version, so its robot waits on the left.</p>
    {variants.map(([title, cls, about]) => (
      <section class={`v ${cls}`}>
        <h2>{title}<span>{about}</span></h2>
        <p class="name">Hi, I'm Apoorva.</p>
        {scenes.map((s) => (
          <div class="scene" data-side={s.side}>
            <p class="line"><span class="lead">{s.lead}</span> <span class="ph">{s.phrase}</span></p>
            <div class="stage"><img src={s.art} alt="" /></div>
            <p class="cap">{s.caption}</p>
          </div>
        ))}
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .lab { max-width: 26rem; margin: 0 auto; padding: 1.5rem var(--gutter) 6rem; display: grid; gap: 3rem; }
  .note { color: var(--muted); font-size: 0.9375rem; }
  h2 { font-size: 0.9375rem; font-weight: 550; } h2 span { display: block; font-weight: 400; color: var(--muted); font-size: 0.8125rem; }
  .v { border: 1px solid var(--line-2); border-radius: var(--r-lg); padding: 1rem 0.5rem 1.5rem; text-align: center; }
  .name { margin: 1.25rem 0 0; font-size: var(--t-hero); font-weight: 600; letter-spacing: -0.06em; line-height: 0.98; }
  .scene { margin-top: 2rem; }
  .scene[data-side='tech'] { --side: var(--tech); } .scene[data-side='fit'] { --side: var(--fit); }
  .line, .cap { margin: 0; font-family: 'Kalam', cursive; font-weight: 700; }
  .stage { aspect-ratio: 4 / 3; margin: 0.75rem 0; background: radial-gradient(ellipse 55% 50% at 50% 62%, color-mix(in srgb, var(--side) 30%, transparent), transparent); }
  .stage img { width: 100%; height: 100%; object-fit: contain; }
  .ph { color: var(--side); }

  .a .line { font-size: 1.75rem; } .a .cap { font-size: 1.25rem; color: var(--body); font-weight: 400; }
  .b .line { font-size: 2.25rem; color: var(--side); } .b .line .lead { color: var(--side); } .b .cap { font-size: 1.375rem; color: var(--fg); }
  .c .line { display: grid; line-height: 1; } .c .lead { font-size: 1.25rem; } .c .ph { font-size: 2.75rem; line-height: 1.05; }
  .c .cap { font-size: 1.25rem; color: var(--muted); font-weight: 400; }
</style>
