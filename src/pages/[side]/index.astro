---
import { site } from '../../data/site';
import ShellLayout from '../../layouts/ShellLayout.astro';
import { getPublished, overviewRows, sides } from '../../lib/pages';

export function getStaticPaths() {
  return [
    { params: { side: 'tech' }, props: { side: 'tech' } },
    { params: { side: 'fitness' }, props: { side: 'fit' } },
  ] as const;
}

const { side } = Astro.props;
const { label, dir, intro } = sides[side];
const pages = await getPublished();
const rows = overviewRows(pages, side);
---

<ShellLayout
  title={`${label} Overview | ${site.name}`}
  description={intro}
  side={side}
  crumbs={[{ label }, { label: 'Overview' }]}
  pages={pages}
  current={`/${dir}/`}
>
  <div class="overview">
    <h1 class="sr-only">Overview</h1>
    <p class="lede">{intro}</p>
    <div class="rows">
      {
        rows.map((row) => {
          const Row = row.href ? 'a' : 'div';
          return (
            <Row
              class:list={['row', { soon: !row.href }]}
              href={row.href}
              target={row.external ? '_blank' : undefined}
              rel={row.external ? 'noopener' : undefined}
            >
              <span class="word display">
                {row.label}
                {!row.href && <span class="tag">Soon</span>}
              </span>
              <span class="blurb row-desc">{row.blurb}</span>
              {row.href && <span class="go" aria-hidden="true">{row.external ? '↗' : '→'}</span>}
            </Row>
          );
        })
      }
    </div>
  </div>
</ShellLayout>

<style>
  .overview {
    max-width: var(--wrap-doc);
    margin: 0 auto;
    padding: var(--top) var(--gutter) 6rem;
  }

  .rows {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding: clamp(1.1rem, 2.6vw, 1.75rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .lede {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .blurb {
    grid-column: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .go {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.5rem;
    color: var(--dim);
    transition:
      transform 0.3s,
      color 0.3s;
  }

  .row:hover .go {
    transform: translateX(6px);
    color: var(--fg);
  }

  .soon {
    opacity: 0.55;
  }

  .soon::before {
    display: none;
  }

  .tag {
    margin-left: 0.75rem;
    vertical-align: middle;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    padding: 0.3rem 0.5rem;
    font: 500 0.8125rem/1.3 'Inter', sans-serif;
    letter-spacing: 0;
    color: var(--dim);
    white-space: nowrap;
  }
</style>

