---
import { site } from '../data/site';
import DocHead from './DocHead.astro';
import ItemCard from './ItemCard.astro';
import ItemList from './ItemList.astro';
import FullLayout from '../layouts/FullLayout.astro';
import { formatDate, pageUrl, sides, type Page } from '../lib/pages';

interface Props {
  posts: Page[];
  title: string;
  intro: string;
  showSide?: boolean;
}

const { posts, title, intro, showSide = false } = Astro.props;
---

<FullLayout title={`${title} | ${site.name}`} description={intro}>
  <div class="wrap">
    <DocHead title={title} intro={intro} />
    <ItemList>
      {
        posts.map((post) => (
          <ItemCard
            href={pageUrl(post)}
            title={post.data.title}
            description={post.data.description}
            meta={showSide ? `${sides[post.data.side].label}, ${formatDate(post.data.date)}` : formatDate(post.data.date)}
          />
        ))
      }
    </ItemList>
  </div>
</FullLayout>

<style>
  .wrap {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem) 6rem;
  }
</style>
