---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
  external?: boolean;
}

const { href, title, description, meta, external = false } = Astro.props;
---

<a class="card" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <strong>{title}</strong>
  {description && <span class="desc">{description}</span>}
  {meta && <span class="meta">{meta}</span>}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--panel);
    transition:
      border-color 0.2s,
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .card:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }

  strong {
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .desc {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--body);
  }

  .meta {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--dim);
  }
</style>
