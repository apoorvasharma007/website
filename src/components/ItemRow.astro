---
interface Props {
  href: string;
  title: string;
  description?: string;
  meta?: string;
}

const { href, title, description, meta } = Astro.props;
---

<a class="entry" href={href}>
  <strong>{title}</strong>
  {description && <span class="desc">{description}</span>}
  {meta && <span class="meta">{meta}</span>}
</a>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }

  strong,
  .desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  strong {
    -webkit-line-clamp: 2;
    font-size: var(--fs-item);
    line-height: 1.35;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .entry:hover strong {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.2em;
  }

  .desc {
    -webkit-line-clamp: 2;
    font-size: var(--fs-desc);
    line-height: var(--lh-desc);
    color: var(--muted);
  }

  .meta {
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    color: var(--dim);
  }
</style>
