---
interface Props {
  headings: { slug: string; text: string }[];
  inline?: boolean;
}

const { headings, inline = false } = Astro.props;
---

{
  headings.length >= 2 && (
    <nav class:list={['ol', { inline }]} data-ol aria-label="On This Page">
      <b>On This Page</b>
      <div class="list">
        <span class="bar"></span>
        {headings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
      </div>
    </nav>
  )
}

<style>
  .ol {
    font-size: 0.875rem;
  }

  .ol b {
    display: block;
    margin-bottom: 0.75rem;
    font: 500 0.8125rem/1.3 'Inter', sans-serif;
    color: var(--dim);
  }

  .list {
    position: relative;
    display: grid;
    border-left: 1px solid var(--line);
  }

  .list a {
    padding: 0.375rem 0 0.375rem 0.875rem;
    color: var(--muted);
    transition: color 0.15s;
  }

  .list a:hover,
  .list a.on {
    color: var(--fg);
  }

  .bar {
    position: absolute;
    left: -1px;
    width: 2px;
    height: 0;
    background: var(--fg);
    transition:
      transform 0.28s var(--ease),
      height 0.28s;
  }

  .inline {
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--panel);
    padding: 1rem 1.125rem;
  }

  .ol:not(.inline) {
    display: none;
  }

  @media (min-width: 1280px) {
    .ol:not(.inline) {
      display: block;
      position: sticky;
      top: 6rem;
      align-self: start;
    }

    .inline {
      display: none;
    }
  }
</style>

<script>
  const lists = document.querySelectorAll<HTMLElement>('[data-ol]');
  const headings = [...(lists[0]?.querySelectorAll('a') ?? [])].map(
    (link) => document.getElementById(link.getAttribute('href')!.slice(1))!,
  );

  function mark(id: string) {
    for (const outline of lists) {
      const bar = outline.querySelector<HTMLElement>('.bar')!;
      for (const link of outline.querySelectorAll<HTMLElement>('a')) {
        const on = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('on', on);
        if (on) {
          bar.style.height = `${link.offsetHeight}px`;
          bar.style.transform = `translateY(${link.offsetTop}px)`;
        }
      }
    }
  }

  if (lists.length > 0) {
    const spy = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.isIntersecting && mark(entry.target.id)),
      { rootMargin: '-90px 0px -70% 0px' },
    );
    headings.forEach((heading) => spy.observe(heading));
    mark(headings[0].id);
  }
</script>
