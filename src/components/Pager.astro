---
import { pageUrl, type Page } from '../lib/pages';

interface Props {
  prev?: Page;
  next?: Page;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="Previous and Next">
      {prev && (
        <a class="pg" href={pageUrl(prev)}>
          <span class="pl">Previous</span>
          <strong>{prev.data.title}</strong>
        </a>
      )}
      {next && (
        <a class="pg next" href={pageUrl(next)}>
          <span class="pl">Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    gap: 0.75rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 640px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pg {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--panel);
    transition: border-color 0.2s;
  }

  .pg:hover {
    border-color: var(--line-2);
  }

  .pl {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }

  strong {
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .next {
    text-align: right;
  }

  .next:only-child {
    grid-column: 2;
  }
</style>
