---
import '../styles/tree.css';
import Icon from './Icon.astro';
import TreeNode from './TreeNode.astro';
import { site } from '../data/site';
import { sideTree, type Page } from '../lib/pages';

interface Props {
  pages: Page[];
  current: string;
}

const { pages, current } = Astro.props;
---

<aside class="side" id="side" aria-label="Site">
  <div class="side-head">
    <a class="logo" href="/" aria-label="Home">AS</a>
    <b>{site.name}</b>
  </div>
  <nav class="side-nav" aria-label="Pages">
    <a class="nl" href="/"><Icon name="grid" />Home</a>
    <TreeNode node={sideTree(pages, 'tech')} current={current} dot="tech" />
    <TreeNode node={sideTree(pages, 'fit')} current={current} dot="fit" />
    <a class="nl" href="/about/"><Icon name="user" />About</a>
    <a class="nl" href="/contact/"><Icon name="doc" />Contact</a>
  </nav>
  <div class="side-foot">
    <a href={site.resume}>Résumé</a>
    <a href={site.github}>GitHub</a>
    <a href={site.youtube}>YouTube</a>
  </div>
</aside>

<style>
  .side {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    width: min(19rem, 86vw);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
    transform: translateX(-102%);
    visibility: hidden;
    transition:
      transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s 0.32s;
  }

  :global(.app.menu-open) .side {
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (min-width: 1024px) {
    .side {
      position: sticky;
      top: 0;
      height: 100vh;
      width: auto;
      transform: none;
      visibility: visible;
      z-index: 1;
      padding-top: 0;
    }
  }

  .side-head {
    height: 4rem;
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .logo {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
    font: 600 0.75rem/1 'Inter', sans-serif;
    letter-spacing: -0.02em;
  }

  .side-head b {
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .side-nav {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0.75rem 1.5rem;
  }

  .side-foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding: 0.75rem 1.25rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .side-foot a {
    min-height: 2.5rem;
    display: flex;
    align-items: center;
  }

  .side-foot a:hover {
    color: var(--fg);
  }
</style>
