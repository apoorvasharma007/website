---
import { site } from '../data/site';

interface Props {
  links?: boolean;
}

const { links = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <span>© {year} {site.name}. All Rights Reserved.</span>
  {
    links && (
      <nav class="footer-links" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/contact/">Contact</a>
      </nav>
    )
  }
</footer>

<style>
  .footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem clamp(1rem, 4vw, 2rem) calc(1.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: var(--dim);
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .footer {
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
    }

    .footer-links {
      order: -1;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
