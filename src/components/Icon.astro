---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icons[name]}
/>

<style>
  .icon {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
</style>
