---
import ItemList from './ItemList.astro';
import ItemRow from './ItemRow.astro';
import { childrenOf, pageUrl, type Page } from '../lib/pages';

interface Props {
  pages: Page[];
  parent: Page;
}

const { pages, parent } = Astro.props;

const groups: { section?: Page; rows: Page[] }[] = [];
for (const item of childrenOf(pages, parent)) {
  const chapters = childrenOf(pages, item);
  const last = groups.at(-1);
  if (chapters.length > 0) groups.push({ section: item, rows: chapters });
  else if (last && !last.section) last.rows.push(item);
  else groups.push({ rows: [item] });
}
---

{
  groups.map(({ section, rows }) => (
    <section>
      {section && (
        <div class="section">
          <h2><a href={pageUrl(section)}>{section.data.title}</a></h2>
          <p>{section.data.description}</p>
        </div>
      )}
      <ItemList>
        {rows.map((row) => (
          <ItemRow href={pageUrl(row)} title={row.data.title} description={row.data.description} />
        ))}
      </ItemList>
    </section>
  ))
}

<style>
  section {
    margin-top: 2.5rem;
  }

  section:first-child {
    margin-top: 0;
  }

  .section {
    margin-top: 2rem;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.2em;
  }

  p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0.25rem 0 0;
    max-width: 40rem;
    font-size: var(--fs-desc);
    line-height: var(--lh-desc);
    color: var(--muted);
  }
</style>
