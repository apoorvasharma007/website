---
import ItemCard from './ItemCard.astro';
import { childrenOf, pageUrl, type Page } from '../lib/pages';

interface Props {
  pages: Page[];
  parent: Page;
}

const { pages, parent } = Astro.props;
---

{
  childrenOf(pages, parent).map((item) => {
    const chapters = childrenOf(pages, item);
    return chapters.length === 0 ? (
      <ItemCard href={pageUrl(item)} title={item.data.title} description={item.data.description} />
    ) : (
      <>
        <div class="section">
          <h2><a href={pageUrl(item)}>{item.data.title}</a></h2>
          <p>{item.data.description}</p>
        </div>
        {chapters.map((chapter) => (
          <ItemCard href={pageUrl(chapter)} title={chapter.data.title} description={chapter.data.description} />
        ))}
      </>
    );
  })
}

<style>
  .section {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
  }

  .section:first-child {
    margin-top: 0;
  }

  h2 {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.2em;
  }

  p {
    margin: 0.25rem 0 0;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
