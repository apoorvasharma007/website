---
import ItemCard from './ItemCard.astro';
import { childrenOf, pageUrl, type Page } from '../lib/pages';

interface Props {
  pages: Page[];
  parent: Page;
}

const { pages, parent } = Astro.props;
---

{
  childrenOf(pages, parent).map((item) =>
    childrenOf(pages, item).length > 0 ? (
      <>
        <a class="heading" href={pageUrl(item)}>{item.data.title}</a>
        <Astro.self pages={pages} parent={item} />
      </>
    ) : (
      <ItemCard href={pageUrl(item)} title={item.data.title} description={item.data.description} />
    ),
  )
}

<style>
  .heading {
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }

  .heading:hover {
    color: var(--fg);
  }
</style>
