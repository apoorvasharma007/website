---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="bar">
  <div class="header">
    <a class="brand" href="/">
      <span class="logo">AS</span>
      <b>{site.name}</b>
    </a>
    <nav class="links" aria-label="Main">
      {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bar);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .header {
    max-width: 72rem;
    margin: 0 auto;
    height: 4rem;
    padding: 0 clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'brand nav theme';
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .logo {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
    font: 600 0.75rem/1 'Inter', sans-serif;
    letter-spacing: -0.02em;
  }

  .links {
    grid-area: nav;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .link {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: 0.625rem;
    color: var(--muted);
    font-size: 0.9375rem;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .link:hover {
    background: var(--panel);
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .header {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav theme';
      gap: 0 0.5rem;
    }

    .brand b {
      display: none;
    }

    .links {
      justify-content: space-between;
    }

    .link {
      padding: 0 0.3125rem;
      font-size: 0.875rem;
    }
  }
</style>
