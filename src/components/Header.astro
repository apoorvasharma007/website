---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header">
  <a class="brand" href="/">
    <span class="logo">AS</span>
    <b>{site.name}</b>
  </a>
  <nav class="links" aria-label="Main">
    {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
  </nav>
  <ThemeToggle />
</header>

<style>
  .header {
    position: relative;
    z-index: 2;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'brand nav theme';
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .logo {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
    font: 600 0.75rem/1 'Inter', sans-serif;
    letter-spacing: -0.02em;
  }

  .links {
    grid-area: nav;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 0.625rem;
    color: var(--muted);
    font-size: 0.9375rem;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .link:hover {
    background: var(--panel);
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .header {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'brand theme' 'nav nav';
    }

    .links {
      justify-content: space-between;
      margin-inline: -0.5rem;
    }
  }

  @media (max-width: 520px) {
    .link {
      padding: 0 0.5rem;
    }
  }
</style>
