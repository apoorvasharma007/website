---
import { site } from '../data/site';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  onHome?: boolean;
}

const { title, description = site.description, onHome = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="full">
  <div class="page">
    <div class="glow" aria-hidden="true"></div>
    {onHome ? <div class="float"><ThemeToggle /></div> : <Header />}
    <main id="main">
      <slot />
    </main>
  </div>
  <Footer onHome={onHome} />
  </div>
</BaseLayout>

<style>
  .float {
    position: fixed;
    top: calc(0.5rem + env(safe-area-inset-top, 0px));
    right: var(--gutter);
    z-index: 10;
    border-radius: var(--r-pill);
    background: var(--bar);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
  }

  .full {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .page {
    flex: 1;
    position: relative;
    overflow-x: clip;
  }

  .glow {
    position: absolute;
    inset: -5rem 0 auto 0;
    height: 34rem;
    pointer-events: none;
    background: radial-gradient(42rem 20rem at 50% 0, var(--glow), transparent 70%);
    animation: drift 16s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate3d(7%, 2rem, 0) scale(1.1);
    }
  }

  /* Frosted bars over moving art flicker on phones, so touch screens get a plain bar. */
  @media (hover: none) {
    .float {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
    }
  }
</style>
