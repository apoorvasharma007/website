---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noai, noimageai" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600&display=swap"
    />
    <script is:inline>
      try {
        var saved = localStorage.getItem('as-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip To Content</a>
    <div class="page">
      <div class="glow" aria-hidden="true"></div>
      <Header />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  .page {
    position: relative;
    overflow-x: clip;
  }

  .glow {
    position: absolute;
    inset: -5rem 0 auto 0;
    height: 34rem;
    pointer-events: none;
    background: radial-gradient(42rem 20rem at 50% 0, var(--glow), transparent 70%);
    animation: drift 16s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate3d(7%, 2rem, 0) scale(1.1);
    }
  }
</style>
