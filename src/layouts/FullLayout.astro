---
import { site } from '../data/site';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  footerLinks?: boolean;
}

const { title, description = site.description, footerLinks = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="page">
    <div class="glow" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
  </div>
  <Footer links={footerLinks} />
</BaseLayout>

<style>
  .page {
    position: relative;
    overflow-x: clip;
  }

  .glow {
    position: absolute;
    inset: -5rem 0 auto 0;
    height: 34rem;
    pointer-events: none;
    background: radial-gradient(42rem 20rem at 50% 0, var(--glow), transparent 70%);
    animation: drift 16s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      transform: translate3d(7%, 2rem, 0) scale(1.1);
    }
  }
</style>
